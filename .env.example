# Copy to .env locally. Keep real keys out of Git and chat.
# Railway: mount a persistent volume at /data and set STUDIQ_INSTANCE_DIR=/data.
# Leave blank for the normal local instance folder.
STUDIQ_INSTANCE_DIR=
# Railway's edge proxy terminates HTTPS; set this to * in Railway Variables.
# Use this only when traffic reaches the server through the trusted hosting proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Use PayMongo TEST keys while developing GCash checkout.
PAYMENTS_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public HTTPS address forwarding to this app (required for provider callbacks).
STUDIQ_PUBLIC_URL=
# In PayMongo, register: https://your-public-address/api/payments/webhook
# Subscribe to checkout_session.payment.paid and use its signing secret above.

# Local development writes downloadable .eml previews. Use smtp for email delivery.
RECEIPT_DELIVERY=file
RECEIPT_FROM_NAME=StudiQ
RECEIPT_FROM_EMAIL=
SMTP_HOST=
# Use port 587 with starttls, or port 465 with ssl.
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
